<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Home Lab Index</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <script>
    tailwind.config = {
      darkMode: 'class',
    }
  </script>
</head>

<body class="bg-gray-100 dark:bg-gray-900 text-gray-800 dark:text-gray-100 min-h-screen flex flex-col font-sans transition-colors duration-300">

  <!-- Header -->
  <header class="bg-white dark:bg-gray-800 shadow-md py-4">
    <div class="container mx-auto px-4 flex flex-col md:flex-row justify-between items-center">
      <div class="text-2xl font-bold mb-4 md:mb-0">
        <a href="http://go/" class="flex items-center gap-2 hover:text-blue-600 dark:hover:text-blue-400">
          <i class="fa fa-home"></i> Home Lab Index
        </a>
      </div>
      <div class="flex flex-wrap gap-2 justify-center">
        <button id="modeToggleBtn" onclick="toggleNightMode()" class="px-4 py-2 bg-gray-200 dark:bg-gray-700 rounded hover:bg-gray-300 dark:hover:bg-gray-600 transition">
          Night Mode
        </button>
        <a href="/view/home" class="px-4 py-2 bg-blue-600 text-white rounded hover:bg-blue-700 transition">Add Link</a>
        <a href="/view/indexes" class="px-4 py-2 bg-gray-200 dark:bg-gray-700 rounded hover:bg-gray-300 dark:hover:bg-gray-600 transition">Indexes</a>
        <a href="/view/setting" class="px-4 py-2 bg-gray-200 dark:bg-gray-700 rounded hover:bg-gray-300 dark:hover:bg-gray-600 transition">Settings</a>
      </div>
    </div>
  </header>

  <!-- Main Content -->
  <main class="flex-grow container mx-auto px-4 py-8 flex flex-col items-center">

    <div class="text-center mb-8">
      <h2 class="text-2xl font-semibold flex items-center justify-center gap-2">
        <i class="fa fa-plus-circle text-blue-500"></i> Add your URLs for Quick Access
      </h2>
    </div>

    <!-- Sample Link Preview -->
    <div class="mb-6 w-full max-w-md text-center">
      <a id="link" href="http://go/<%= defaults.value %>" class="inline-block px-6 py-3 bg-indigo-600 text-white font-medium rounded shadow hover:bg-indigo-700 transition w-full truncate">
        Sample&#128279;: go/<%= defaults.value %>
      </a>
    </div>

    <!-- Form -->
    <div class="w-full max-w-md bg-white dark:bg-gray-800 p-8 rounded-lg shadow-lg">
      <form id="urlForm" method="POST" action="/action/insert" class="space-y-6" novalidate>

        <!-- Category -->
        <div>
          <label for="dropdown" class="block text-sm font-medium mb-2">
            <i class="fa fa-list-dots mr-1"></i> Category
          </label>
          <select name="dropdown" id="dropdown" class="w-full p-3 border border-gray-300 dark:border-gray-600 rounded bg-gray-50 dark:bg-gray-700 focus:outline-none focus:ring-2 focus:ring-blue-500 transition">
            <% for(var i=0; i<defaults.dropdownValues.length; i++) { %>
              <option value="<%= defaults.dropdownValues[i] %>">
                <%= defaults.dropdownValues[i] %>
              </option>
            <% } %>
          </select>
        </div>

        <!-- Custom Category Input -->
        <div id="customValueContainer" class="hidden">
          <input type="text" name="customValue" id="customValue" placeholder="Enter Custom Category" class="w-full p-3 border border-gray-300 dark:border-gray-600 rounded bg-gray-50 dark:bg-gray-700 focus:outline-none focus:ring-2 focus:ring-blue-500 transition">
        </div>

        <!-- Key -->
        <div>
          <label for="key" class="block text-sm font-medium mb-2">
            <i class="fa fa-key mr-1"></i> Key
          </label>
          <input type="text" name="key" id="key" value="<%= defaults.value %>" required class="w-full p-3 border border-gray-300 dark:border-gray-600 rounded bg-gray-50 dark:bg-gray-700 focus:outline-none focus:ring-2 focus:ring-blue-500 transition">
        </div>

        <!-- URL -->
        <div>
          <label for="url" class="block text-sm font-medium mb-2">
            <i class="fa fa-link mr-1"></i> URL
          </label>
          <input type="url" name="url" id="url" value="" required placeholder="https://example.com" class="w-full p-3 border border-gray-300 dark:border-gray-600 rounded bg-gray-50 dark:bg-gray-700 focus:outline-none focus:ring-2 focus:ring-blue-500 transition">
          <p class="text-xs text-red-500 mt-1 hidden" id="urlError">Please enter a valid URL including http:// or https://</p>
        </div>

        <!-- Submit Button -->
        <button type="submit" class="w-full py-3 bg-green-600 text-white font-bold rounded hover:bg-green-700 transition duration-300 transform hover:scale-[1.02]">
          Submit
        </button>

      </form>
    </div>

  </main>

  <script>
    var dropdown = document.getElementById('dropdown');
    var customValue = document.getElementById('customValue');
    var customValueContainer = document.getElementById('customValueContainer');
    var modeToggleBtn = document.getElementById('modeToggleBtn');
    var htmlElement = document.documentElement;

    function toggleNightMode() {
      htmlElement.classList.toggle('dark');

      // Save preference (optional, using localStorage)
      const isDark = htmlElement.classList.contains('dark');
      localStorage.setItem('theme', isDark ? 'dark' : 'light');

      updateButtonText();
    }

    function updateButtonText() {
       if (htmlElement.classList.contains('dark')) {
        modeToggleBtn.textContent = 'Day Mode';
      } else {
        modeToggleBtn.textContent = 'Night Mode';
      }
    }

    // Initialize theme based on preference or system
    if (localStorage.getItem('theme') === 'dark' || (!('theme' in localStorage) && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
      htmlElement.classList.add('dark');
    } else {
      htmlElement.classList.remove('dark');
    }
    updateButtonText();

    // Show the custom value input field when the "Custom" option is selected
    function checkCustomValue() {
      if (dropdown.value.includes('Custom')) {
        customValueContainer.classList.remove('hidden');
        customValue.setAttribute('required', '');
      } else {
        customValueContainer.classList.add('hidden');
        customValue.removeAttribute('required');
      }
    }

    dropdown.addEventListener('change', checkCustomValue);
    // Run on load in case it's pre-selected
    checkCustomValue();


    const keyInput = document.getElementById('key');
    const link = document.getElementById('link');

    keyInput.addEventListener('input', (event) => {
      const newValue = event.target.value;
      if(newValue) {
          link.href = `http://go/${encodeURIComponent(newValue)}`;
          link.innerText = `Sample\u{1F517}: go/${newValue}`;
      } else {
          link.innerText = `Sample\u{1F517}: go/`;
      }
    });

    // Client-side validation for URL
    const urlInput = document.getElementById('url');
    const urlForm = document.getElementById('urlForm');
    const urlError = document.getElementById('urlError');

    urlInput.addEventListener('input', () => {
        if(urlInput.validity.valid) {
             urlError.classList.add('hidden');
             urlInput.classList.remove('border-red-500');
        }
    });

    urlForm.addEventListener('submit', (e) => {
        if (!urlInput.validity.valid) {
            e.preventDefault();
            urlError.classList.remove('hidden');
            urlInput.classList.add('border-red-500');
        }
    });

  </script>
</body>
</html>
