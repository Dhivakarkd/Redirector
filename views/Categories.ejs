<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>List of URLs</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <script>
    tailwind.config = {
      darkMode: 'class',
    }
  </script>
</head>

<body class="bg-gray-100 dark:bg-gray-900 text-gray-800 dark:text-gray-100 min-h-screen flex flex-col font-sans transition-colors duration-300">

  <!-- Header -->
  <header class="bg-white dark:bg-gray-800 shadow-md py-4">
    <div class="container mx-auto px-4 flex flex-col md:flex-row justify-between items-center">
      <div class="text-2xl font-bold mb-4 md:mb-0">
        <a href="http://go/" class="flex items-center gap-2 hover:text-blue-600 dark:hover:text-blue-400">
          <i class="fa fa-home"></i> Home Lab Index
        </a>
      </div>
      <div class="flex flex-wrap gap-2 justify-center">
        <button id="modeToggleBtn" onclick="toggleNightMode()" class="px-4 py-2 bg-gray-200 dark:bg-gray-700 rounded hover:bg-gray-300 dark:hover:bg-gray-600 transition">
           Night Mode
        </button>
        <a href="/view/home" class="px-4 py-2 bg-gray-200 dark:bg-gray-700 rounded hover:bg-gray-300 dark:hover:bg-gray-600 transition">Add Link</a>
        <a href="/view/indexes" class="px-4 py-2 bg-blue-600 text-white rounded hover:bg-blue-700 transition">Indexes</a>
        <a href="/view/setting" class="px-4 py-2 bg-gray-200 dark:bg-gray-700 rounded hover:bg-gray-300 dark:hover:bg-gray-600 transition">Settings</a>
      </div>
    </div>
  </header>

  <!-- Main Content -->
  <main class="flex-grow container mx-auto px-4 py-8">

    <!-- Category Filter -->
    <div class="mb-8 flex justify-center items-center gap-4">
      <label for="category-dropdown" class="text-lg font-medium">Select category:</label>
      <select id="category-dropdown" class="p-2 border border-gray-300 dark:border-gray-600 rounded bg-white dark:bg-gray-800 focus:outline-none focus:ring-2 focus:ring-blue-500 transition">
        <% categories.forEach((category)=> { %>
          <option value="<%= category %>">
            <%= category %>
          </option>
        <% }); %>
      </select>
    </div>

    <!-- URL Table -->
    <div class="bg-white dark:bg-gray-800 shadow-lg rounded-lg overflow-hidden">
      <div class="overflow-x-auto">
        <table id="url-table" class="w-full text-left border-collapse">
          <thead>
            <tr class="bg-gray-200 dark:bg-gray-700 text-gray-700 dark:text-gray-200 text-sm uppercase tracking-wider">
              <th class="p-4 border-b border-gray-300 dark:border-gray-600">Key</th>
              <th class="p-4 border-b border-gray-300 dark:border-gray-600">Website Links</th>
              <th class="p-4 border-b border-gray-300 dark:border-gray-600">Category</th>
              <th class="p-4 border-b border-gray-300 dark:border-gray-600">Action</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-200 dark:divide-gray-600">
             <!-- Rows will be populated by JS -->
          </tbody>
        </table>
      </div>
    </div>

    <!-- Pagination -->
    <div id="pagination-container" class="mt-6 flex justify-center">
        <div id="pagination" class="flex items-center gap-4">
            <button id="prevPage" class="px-4 py-2 bg-gray-300 dark:bg-gray-600 rounded hover:bg-gray-400 dark:hover:bg-gray-500 transition disabled:opacity-50">Previous</button>
            <span id="currentPage" class="text-lg font-medium">Page 1</span>
            <button id="nextPage" class="px-4 py-2 bg-gray-300 dark:bg-gray-600 rounded hover:bg-gray-400 dark:hover:bg-gray-500 transition disabled:opacity-50">Next</button>
        </div>
    </div>

  </main>

  <script src="/js/CategoryHelper.js"></script>
  <script>
    // Night Mode Logic (Consistent across pages)
    var modeToggleBtn = document.getElementById('modeToggleBtn');
    var htmlElement = document.documentElement;

    function toggleNightMode() {
      htmlElement.classList.toggle('dark');
      const isDark = htmlElement.classList.contains('dark');
      localStorage.setItem('theme', isDark ? 'dark' : 'light');
      updateButtonText();
    }

    function updateButtonText() {
       if (htmlElement.classList.contains('dark')) {
        modeToggleBtn.textContent = 'Day Mode';
      } else {
        modeToggleBtn.textContent = 'Night Mode';
      }
    }

    if (localStorage.getItem('theme') === 'dark' || (!('theme' in localStorage) && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
      htmlElement.classList.add('dark');
    } else {
      htmlElement.classList.remove('dark');
    }
    updateButtonText();
  </script>
</body>

</html>
