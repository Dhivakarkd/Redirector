<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Error</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <script>
      tailwind.config = {
        darkMode: 'class',
      }
    </script>
</head>
<body class="bg-gray-100 dark:bg-gray-900 text-gray-800 dark:text-gray-100 min-h-screen flex items-center justify-center transition-colors duration-300">
    <div class="text-center p-8 bg-white dark:bg-gray-800 shadow-lg rounded-lg max-w-md w-full">
        <h1 class="text-4xl font-bold text-red-600 mb-4">
            <i class="fa fa-exclamation-circle"></i> Error
        </h1>
        <p class="text-xl text-gray-700 dark:text-gray-300 mb-6"><%= message %></p>

        <a href="javascript:history.back()" class="inline-block px-6 py-3 bg-blue-600 text-white font-medium rounded hover:bg-blue-700 transition duration-300">
            Go Back
        </a>
        <div class="mt-4">
            <a href="/" class="text-blue-500 hover:underline text-sm">Return to Home</a>
        </div>

    </div>
    <script src="/js/theme.js"></script>
</body>
</html>
