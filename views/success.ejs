<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Creation Success</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <script>
    tailwind.config = {
      darkMode: 'class',
    }
  </script>
</head>

<body class="bg-gray-100 dark:bg-gray-900 text-gray-800 dark:text-gray-100 min-h-screen flex flex-col font-sans transition-colors duration-300">

  <!-- Header -->
  <header class="bg-white dark:bg-gray-800 shadow-md py-4">
    <div class="container mx-auto px-4 flex flex-col md:flex-row justify-between items-center">
      <div class="text-2xl font-bold mb-4 md:mb-0">
        <a href="http://go/" class="flex items-center gap-2 hover:text-blue-600 dark:hover:text-blue-400">
          <i class="fa fa-home"></i> Home Lab Index
        </a>
      </div>
      <div class="flex flex-wrap gap-2 justify-center">
        <button id="modeToggleBtn" onclick="toggleNightMode()" class="px-4 py-2 bg-gray-200 dark:bg-gray-700 rounded hover:bg-gray-300 dark:hover:bg-gray-600 transition">
           Night Mode
        </button>
        <a href="/view/home" class="px-4 py-2 bg-gray-200 dark:bg-gray-700 rounded hover:bg-gray-300 dark:hover:bg-gray-600 transition">Add Link</a>
        <a href="/view/indexes" class="px-4 py-2 bg-gray-200 dark:bg-gray-700 rounded hover:bg-gray-300 dark:hover:bg-gray-600 transition">Indexes</a>
        <a href="/view/setting" class="px-4 py-2 bg-gray-200 dark:bg-gray-700 rounded hover:bg-gray-300 dark:hover:bg-gray-600 transition">Settings</a>
      </div>
    </div>
  </header>

  <!-- Main Content -->
  <main class="flex-grow container mx-auto px-4 py-8 flex flex-col items-center justify-center">

    <div class="bg-white dark:bg-gray-800 p-8 rounded-lg shadow-lg w-full max-w-md text-center">
      <h2 class="text-2xl font-bold text-green-600 mb-6 flex items-center justify-center gap-2">
        <i class="fa fa-check-circle"></i> Quick Link Created Successfully
      </h2>

      <div class="space-y-4 mb-8 text-left">
        <div class="flex items-center gap-2 text-lg">
          <i class="fa fa-key text-gray-500"></i>
          <span class="font-semibold">Key:</span>
          <span><%= defaults.key %></span>
        </div>
        <div class="flex items-center gap-2 text-lg">
          <i class="fa fa-link text-gray-500"></i>
          <span class="font-semibold">URL:</span>
          <a href="<%= defaults.value %>" class="text-blue-600 hover:underline truncate block max-w-xs"><%= defaults.value %></a>
        </div>
      </div>

      <div class="flex flex-col gap-4">
        <a href="http://go/<%= defaults.key %>" class="w-full px-6 py-3 bg-indigo-600 text-white font-medium rounded hover:bg-indigo-700 transition flex items-center justify-center gap-2">
          <i class="fa fa-external-link-alt"></i> go/<%= defaults.key %>
        </a>

        <a href="/view/home" class="w-full px-6 py-3 bg-gray-200 dark:bg-gray-700 text-gray-800 dark:text-gray-100 font-medium rounded hover:bg-gray-300 dark:hover:bg-gray-600 transition flex items-center justify-center gap-2">
          <i class="fa-solid fa-plus"></i> Add More
        </a>
      </div>

    </div>

  </main>

  <script>
     // Night Mode Logic (Consistent across pages)
    var modeToggleBtn = document.getElementById('modeToggleBtn');
    var htmlElement = document.documentElement;

    function toggleNightMode() {
      htmlElement.classList.toggle('dark');
      const isDark = htmlElement.classList.contains('dark');
      localStorage.setItem('theme', isDark ? 'dark' : 'light');
      updateButtonText();
    }

    function updateButtonText() {
       if (htmlElement.classList.contains('dark')) {
        modeToggleBtn.textContent = 'Day Mode';
      } else {
        modeToggleBtn.textContent = 'Night Mode';
      }
    }

    if (localStorage.getItem('theme') === 'dark' || (!('theme' in localStorage) && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
      htmlElement.classList.add('dark');
    } else {
      htmlElement.classList.remove('dark');
    }
    updateButtonText();
  </script>

</body>

</html>
